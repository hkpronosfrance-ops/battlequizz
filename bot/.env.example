# Copie ce fichier en ".env" et remplis les valeurs

# Pseudo TikTok du compte qui streame (sans @)
TIKTOK_USERNAME=hkpronosfrance

# --- Supabase ---
# URL et clé service_role : Supabase → Project Settings → API
# ⚠️ La clé service_role est SECRÈTE (contourne toutes les protections RLS) :
# ne la mets JAMAIS dans le code du site web (web/), uniquement ici, sur ton PC.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=ta_cle_service_role_secrete

# --- Voix IA ---
VOICE_ENABLED=true
TTS_PROVIDER=edge
EDGE_VOICE=fr-FR-RemyMultilingualNeural
ELEVENLABS_API_KEY=ta_cle_elevenlabs
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Intervalle de vérification de la session/question active (ms)
POLL_INTERVAL_MS=2000

# --- Optionnel : clé Euler Stream (service de signature requis par TikTok) ---
# Fonctionne sans clé (usage anonyme limité), mais recommandé si tu as des erreurs
# de connexion fréquentes ou un usage intensif. Gratuit sur https://www.eulerstream.com
EULERSTREAM_API_KEY=

